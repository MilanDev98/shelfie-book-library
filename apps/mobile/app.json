{
  "expo": {
    "name": "Shelfie",
    "slug": "shelfie",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/shelfie-icon.png",
    "scheme": "shelfie",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/shelfie-icon.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FAF7F1",
        "foregroundImage": "./assets/images/shelfie-icon-foreground.png",
        "monochromeImage": "./assets/images/shelfie-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/shelfie-favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FAF7F1",
          "image": "./assets/images/shelfie-splash.png",
          "imageWidth": 112
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
