# Django
DJANGO_SECRET_KEY=replace-me-for-non-local-environments
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006

# Local CPU book-spine detection
SPINE_DETECTOR_MODEL_ID=google/owlv2-base-patch16-ensemble
SPINE_DETECTOR_CACHE_DIR=.cache/huggingface
SPINE_DETECTOR_DEFAULT_PROMPT=book spine
SPINE_DETECTOR_DEFAULT_THRESHOLD=0.3
SPINE_DETECTOR_NMS_IOU_THRESHOLD=0.5
SPINE_DETECTOR_MAX_DETECTIONS=12
SPINE_IMAGE_MAX_UPLOAD_BYTES=10485760
SPINE_IMAGE_MAX_PIXELS=40000000

# Hosted book-spine title/author recognition through OpenRouter
# Choose a model only after confirming its OpenRouter model page lists image input and
# structured-output/JSON-schema support. Keep the API key only in the ignored local .env file.
OPENROUTER_API_KEY=
OPENROUTER_VISION_MODEL=google/gemini-2.5-flash

# Expo
EXPO_PUBLIC_API_URL=http://localhost:8000
